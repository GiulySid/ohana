Options -Indexes
DirectoryIndex index.php

<IfModule mod_php.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 40M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 40M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 40M
</IfModule>

<Files "credentials.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
