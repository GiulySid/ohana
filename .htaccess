Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep pretty URLs inside this folder (works at / and /ohana/)
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]+/)*)index\.php[\s?] [NC]
  RewriteRule ^index\.php$ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]+/)*)media\.php[\s?] [NC]
  RewriteRule ^media\.php$ /%1galleria [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]+/)*)[^/\s?]+\.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !/admin/
  RewriteRule ^([^/]+)\.php$ /%1$1 [R=301,L]

  # /galleria is an alias of media.php (a /media folder already exists)
  RewriteRule ^galleria/?$ media.php [L]

  # /compagnia → compagnia.php (even if a folder with the same name exists)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [L]

  # Aliases and unknown paths → front controller (pretty 404s)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/]+)/?$ index.php [L]
</IfModule>
